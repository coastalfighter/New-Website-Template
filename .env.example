# Akrostech website — build-time configuration.
# Copy to `.env` (or set in your host's dashboard) before running `npm run build`.

# Absolute production origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, JSON-LD, sitemap.xml, robots.txt and llms.txt.
SITE_URL=https://www.akrostech.com

# Port for the local preview server (`npm run dev` / `npm run serve`).
PORT=4173
